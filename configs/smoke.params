# Overrides for a fast deterministic PTA smoke test.
Rerun 4242
Run_num_file run.num
Output_path output
Print_params 0
Print_step 0
Gnuplot_plots 0
Animate_thresh 0
Max_steps 40
Pop_size 20
Num_tasks 4
Task_opposition_mode 1
Task_demand_pattern legacy_vector_scurve
Target_path scurve
Task_selection random
Range 10
Step_ratio 2.0
Thresh_dynamic 2
Thresh_dynamic_init 0
Pid 1
Pid_latent_thresholds 0
Pid_integral_leak 0.99
Pid_integral_bound 500
Agent_pid_gains 0
P_gain 0.001
I_gain 0.0000001
D_gain 0.01
Kill_number 0
First_extinction -1
Extinction_period 0
Removal_capacity_mode 1
FixedTargetPath 1
TargetPathSeed 4242
Feedback_noise_enabled 0
Feedback_noise_alpha 0
Feedback_noise_clip 0
Feedback_bias_alpha 0
Feedback_bias_mode none
